# Printer WLAN screen: IP, access code, serial. Never commit these.
BAMBU_IP=
BAMBU_SERIAL=
BAMBU_ACCESS_CODE=
BAMBU_NAME=X2D
# 127.0.0.1 serves only this Mac. 0.0.0.0 serves the LAN; set STATS_TOKEN then.
PRINT_HOST=127.0.0.1
PRINT_PORT=8080
LOG_LEVEL=INFO
# Optional. If set, GET /print.json requires header X-Stats-Token.
STATS_TOKEN=
